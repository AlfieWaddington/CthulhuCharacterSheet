            <Viewbox Grid.Column="0">
                <Viewbox.LayoutTransform>
                    <RotateTransform Angle="270" />
                </Viewbox.LayoutTransform>
                <Label Content="Combat"/>
            </Viewbox>

            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" >

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="301*"/>
                        <ColumnDefinition Width="89*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Viewbox>
                            <Label Content="Move" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Viewbox>

                        <Viewbox Grid.Row="1">
                            <Label Content="Build" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                        </Viewbox>

                        <Viewbox Grid.Row="2">
                            <Label Content="Dodge" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="2" VerticalAlignment="Center"/>
                        </Viewbox>

                        <Viewbox Grid.Row="3">
                            <Label Content="Damage Bonus" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Viewbox>

                        <TextBox Name="Move" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"/>
                        <TextBox Name="Build" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"/>
                        <TextBox Name="Dodge" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,0" Grid.Row="2" TextWrapping="Wrap" Text="{Binding ElementName=DodgeReg,Path=Text}" VerticalAlignment="Center" Width="120"/>
                        <TextBox Name="DodgeHalfCombat" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0,0,0,0" Grid.Row="2" TextWrapping="Wrap" Text="{Binding ElementName=Dodge,Path=Text,Converter={StaticResource HalfConverter}}" VerticalAlignment="Center" Width="120"/>
                        <TextBox Name="DodgeFifthCombat" Grid.Column="3" HorizontalAlignment="Stretch" Margin="0,0,10,0" Grid.Row="2" TextWrapping="Wrap" Text="{Binding ElementName=Dodge,Path=Text,Converter={StaticResource FifthConverter}}" VerticalAlignment="Center" Width="120"/>
                        <TextBox Name="DamageBonus" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"  Margin="0,0,0,0" Grid.Row="3" TextWrapping="Wrap" >
                            <TextBox.Text>
                                <MultiBinding Converter="{StaticResource DamageBonusConverter}">
                                    <Binding ElementName="StrReg" Path="Text" />
                                    <Binding ElementName="SizeReg" Path="Text" />
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>

                    </Grid>


                </Grid>
            </Border>
            
        </Grid>
        


    </Grid>
</Window>
