<Window x:Class="CthulhuCharacterSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CthulhuCharacterSheet"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280">
    
    <Grid ShowGridLines="true">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*" />
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,7"  ShowGridLines="true">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid ShowGridLines="true">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <Grid RenderTransformOrigin="0.489,0.474"  ShowGridLines="true">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1" ShowGridLines="false">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Grid.Row="0" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="0" Content="Name" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="1" Grid.Row="0" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="1" Content="Birthplace" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="2" Grid.Row="0" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="2" Content="Pronoun" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="0" Grid.Row="1" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="0" Content="Occupation" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="1" Grid.Row="1" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="1" Content="Residence" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="2" Grid.Row="2" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="2" Content="Age" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>



                    </Grid>
                    <Label Content="Investigator" HorizontalAlignment="Center" VerticalAlignment="Center"/>




                </Grid>

            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Grid.Column="0"  HorizontalAlignment="Stretch" Margin="5,5,5,5" VerticalAlignment="Stretch">
                    <Image HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" Source="/assets/WhiteSquare.png" Focusable="true"/>
                </Border>
                <Image Grid.Row="1" Grid.Column="0"  HorizontalAlignment="Stretch"  Margin="5,5,5,5" VerticalAlignment="Stretch" Source="/assets/CallOfCthulhuLogo.png" Stretch="Fill"/>
            </Grid>

        </Grid>

    </Grid>
</Window>
