<Window x:Class="CthulhuCharacterSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CthulhuCharacterSheet"
        
    
    mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600">

    <Window.Resources>
        <local:HalfConverter x:Key="HalfConverter"/>
        <local:FifthConverter x:Key="FifthConverter" />
        <local:DamageBonusConverter x:Key="DamageBonusConverter" />
    </Window.Resources>
    

    <Window.Background>
        <ImageBrush ImageSource="/assets/PaperBG.jpg" />
    </Window.Background>

    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="295*"/>
            <RowDefinition Height="74*" />
            <RowDefinition Height="295*"/>

            <RowDefinition Height="147*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,7"  ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid ShowGridLines="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <Grid RenderTransformOrigin="0.489,0.474"  ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1" ShowGridLines="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Grid.Row="0" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="0" Content="Name" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Name="Name" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="1" Grid.Row="0" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="1" Content="Birthplace" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Name="Birthplace" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="2" Grid.Row="0" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="2" Content="Pronoun" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Name="Pronoun" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="0" Grid.Row="1" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="0" Content="Occupation" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Name="Occupation" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="1" Grid.Row="1" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="1" Content="Residence" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Name="Residence" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Grid.Column="2" Grid.Row="2" LastChildFill="true" Margin="0,0,5,0">
                            <Label Grid.Column="2" Content="Age" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Name="Age" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Margin="5,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" />
                        </DockPanel>



                    </Grid>
                    <Label Content="Investigator" HorizontalAlignment="Center" VerticalAlignment="Center"/>




                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="19*"/>
                    </Grid.ColumnDefinitions>
                    <Label Name="Characteristics" Content="Characteristics" Grid.Column="0" HorizontalAlignment="Left" Margin="0,5,0,0" VerticalAlignment="Bottom" >
                        <Label.LayoutTransform>
                            <RotateTransform Angle="270" />
                        </Label.LayoutTransform>
                    </Label>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>


                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <Label Name="Str" Content="Str" Grid.Column="0" Grid.Row="1"/>
                            <Label Name="Con" Content="Con" Grid.Column="0" Grid.Row="2" />
                            <Label Name="Dex" Content="Dex" Grid.Column="0" Grid.Row="3" />
                            <Label Name="Int" Content="Int" Grid.Column="0" Grid.Row="4"/>

                            <Label Name="Reg1" Content="Reg" Grid.Column="1" Grid.Row="0"/>
                            <Label Name="Half1" Content="Half" Grid.Column="2" Grid.Row="0" />
                            <Label Name="Fifth1" Content="Fifth" Grid.Column="3" Grid.Row="0" />

                            <TextBox Name="StrReg" Text=""  Grid.Column="1" Grid.Row="1" Margin="0,1,0,1"/>
                            <TextBox Name="StrHalf" Text="{Binding ElementName=StrReg,Path=Text,Converter={StaticResource HalfConverter}}"  Grid.Column="2" Grid.Row="1" Margin="0,1,0,1"/>
                            <TextBox Name="StrFifth" Text="{Binding ElementName=StrReg,Path=Text,Converter={StaticResource FifthConverter}}"  Grid.Column="3" Grid.Row="1" Margin="0,1,0,1"/>
                            <TextBox Name="ConReg" Text=""  Grid.Column="1" Grid.Row="2" Margin="0,1,0,1"/>
                            <TextBox Name="ConHalf" Text="{Binding ElementName=ConReg,Path=Text,Converter={StaticResource HalfConverter}}"  Grid.Column="2" Grid.Row="2" Margin="0,1,0,1"/>
                            <TextBox Name="ConFifth" Text="{Binding ElementName=ConReg,Path=Text,Converter={StaticResource FifthConverter}}"  Grid.Column="3" Grid.Row="2" Margin="0,1,0,1"/>
                            <TextBox Name="DexReg" Text=""  Grid.Column="1" Grid.Row="3" Margin="0,1,0,1"/>
                            <TextBox Name="DexHalf" Text="{Binding ElementName=DexReg,Path=Text,Converter={StaticResource HalfConverter}}"  Grid.Column="2" Grid.Row="3" Margin="0,1,0,1"/>
                            <TextBox Name="DexFifth" Text="{Binding ElementName=DexReg,Path=Text,Converter={StaticResource FifthConverter}}"  Grid.Column="3" Grid.Row="3" Margin="0,1,0,1"/>
                            <TextBox Name="IntReg" Text=""  Grid.Column="1" Grid.Row="4" Margin="0,1,0,1"/>
                            <TextBox Name="IntHalf" Text="{Binding ElementName=IntReg,Path=Text,Converter={StaticResource HalfConverter}}"  Grid.Column="2" Grid.Row="4" Margin="0,1,0,1"/>
                            <TextBox Name="IntFifth" Text="{Binding ElementName=IntReg,Path=Text,Converter={StaticResource FifthConverter}}"  Grid.Column="3" Grid.Row="4" Margin="0,1,0,1"/>

                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <Label Name="Siz" Content="Siz" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right"/>
                            <Label Name="Pow" Content="Pow" Grid.Column="0" Grid.Row="2"  HorizontalAlignment="Right"/>
                            <Label Name="App" Content="App" Grid.Column="0" Grid.Row="3"  HorizontalAlignment="Right"/>
                            <Label Name="Edu" Content="Edu" Grid.Column="0" Grid.Row="4"  HorizontalAlignment="Right"/>

                            <Label Name="Reg2" Content="Reg" Grid.Column="1" Grid.Row="0"/>
                            <Label Name="Half2" Content="Half" Grid.Column="2" Grid.Row="0" />
                            <Label Name="Fifth2" Content="Fifth" Grid.Column="3" Grid.Row="0" />

                            <TextBox Name="SizReg" Text=""  Grid.Column="1" Grid.Row="1" Margin="0,1,0,1"/>
                            <TextBox Name="SizHalf" Text="{Binding ElementName=SizReg,Path=Text,Converter={StaticResource HalfConverter}}"  Grid.Column="2" Grid.Row="1" Margin="0,1,0,1"/>
                            <TextBox Name="SizFifth" Text="{Binding ElementName=SizReg,Path=Text,Converter={StaticResource FifthConverter}}"  Grid.Column="3" Grid.Row="1" Margin="0,1,0,1"/>
                            <TextBox Name="PowReg" Text=""  Grid.Column="1" Grid.Row="2" Margin="0,1,0,1"/>
                            <TextBox Name="PowHalf" Text="{Binding ElementName=PowReg,Path=Text,Converter={StaticResource HalfConverter}}"  Grid.Column="2" Grid.Row="2" Margin="0,1,0,1"/>
                            <TextBox Name="PowFifth" Text="{Binding ElementName=PowReg,Path=Text,Converter={StaticResource FifthConverter}}"  Grid.Column="3" Grid.Row="2" Margin="0,1,0,1"/>
                            <TextBox Name="AppReg" Text=""  Grid.Column="1" Grid.Row="3" Margin="0,1,0,1"/>
                            <TextBox Name="AppHalf" Text="{Binding ElementName=AppReg,Path=Text,Converter={StaticResource HalfConverter}}"  Grid.Column="2" Grid.Row="3" Margin="0,1,0,1"/>
                            <TextBox Name="AppFifth" Text="{Binding ElementName=AppReg,Path=Text,Converter={StaticResource FifthConverter}}"  Grid.Column="3" Grid.Row="3" Margin="0,1,0,1"/>
                            <TextBox Name="EduReg" Text=""  Grid.Column="1" Grid.Row="4" Margin="0,1,0,1"/>
                            <TextBox Name="EduHalf" Text="{Binding ElementName=EduReg,Path=Text,Converter={StaticResource HalfConverter}}"  Grid.Column="2" Grid.Row="4" Margin="0,1,0,1"/>
                            <TextBox Name="EduFifth" Text="{Binding ElementName=EduReg,Path=Text,Converter={StaticResource FifthConverter}}"  Grid.Column="3" Grid.Row="4" Margin="0,1,0,1"/>

                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <Label Name="HitPoints" Content="Hit Points" Grid.Column="0" Grid.Row="1"/>
                            <Label Name="MagicPoints" Content="Magic Points" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <Label Name="Luck" Content="Luck" Grid.Column="0" Grid.Row="4" />
                            <Label Name="Sanity" Content="Sanity" Grid.Column="0" Grid.Row="5"/>


                            <Label Name="Maximum" Content="Maximum" Grid.Column="1" Grid.Row="0" />
                            <Label Name="Current" Content="Current" Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>
                            <Label Name="Starting" Content="Starting" Grid.Column="1" Grid.Row="3" Margin="0,1,0,0" VerticalAlignment="Stretch"/>

                            <Label Name="Current2" Content="Current" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>

                            <TextBox Name="MaxHP" Text=""  Grid.Column="1" Grid.Row="1" Margin="0,1,0,1"/>
                            <TextBox Name="CurrentHP" Text=""  Grid.Column="2" Grid.Row="1" Margin="0,1,0,1" Grid.ColumnSpan="2"/>

                            <TextBox Name="MaxMP" Text=""  Grid.Column="1" Grid.Row="2" Margin="0,1,0,1"/>
                            <TextBox Name="CurrentMP" Text=""  Grid.Column="2" Grid.Row="2" Margin="0,1,0,1" Grid.ColumnSpan="2"/>

                            <TextBox Name="StartingLuck" Text=""  Grid.Column="1" Grid.Row="4" Margin="0,1,0,1"/>
                            <TextBox Name="CurrentLuck" Text=""  Grid.Column="2" Grid.Row="4" Margin="0,1,0,1" Grid.ColumnSpan="2"/>

                            <TextBox Name="StartingSanity" Text=""  Grid.Column="1" Grid.Row="5" Margin="0,1,0,1"/>
                            <TextBox Name="CurrentSanity" Text=""  Grid.Column="2" Grid.Row="5" Margin="0,1,0,1"/>
                            <StackPanel Grid.Column="4" Grid.Row="5" Orientation="Horizontal" >
                                <Label Name="InsanityLabel" Content="Insane?"/>
                                <CheckBox Name="Insane" Grid.Column="3" Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </StackPanel>




                        </Grid>


                    </Grid>

                </Grid>

            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="5,5,5,5" VerticalAlignment="Stretch" >
                    <Image Name="CharacterPortrait" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" Source="/assets/WhiteSquare.png" Focusable="true" Stretch="Uniform"/>
                </Border>
                <Image Grid.Row="1" Grid.Column="0"  HorizontalAlignment="Stretch"  Margin="5,5,5,5" VerticalAlignment="Stretch" Source="/assets/CallOfCthulhuLogo.png" Stretch="Fill"/>
            </Grid>

        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="1">
                <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" LastChildFill="True">
                    <Label Content="Max Sanity" />
                    <TextBox Name="MaxSanity" Text="" DockPanel.Dock="Right" MinWidth="20"/>
                </DockPanel>
            </Viewbox>
            <Viewbox Grid.Column="2">
                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Temporary Insanity" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <CheckBox Name="TempInsanity" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Viewbox>
            <Viewbox  Grid.Column="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Indefinite Insanity" />
                    <CheckBox Name="InfInsanity" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Viewbox>
            <Viewbox Grid.Column="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Major Wound" />
                    <CheckBox Name="MajWound" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Viewbox>
            <Viewbox  Grid.Column="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Unconcious" />
                    <CheckBox Name="Unconcious" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Viewbox>
            <Viewbox Grid.Column="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Label Content="Dying" />
                    <CheckBox Name="Dying" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Center"/>

                </StackPanel>
            </Viewbox>


        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="39*"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0">
                <Viewbox.LayoutTransform>
                    <RotateTransform Angle="270" />
                </Viewbox.LayoutTransform>
                <Label Content="Skills"/>
            </Viewbox>

            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="10*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Reg" Grid.Column="1" HorizontalAlignment="Center"/>
                        <Label Content="Half" Grid.Column="2" HorizontalAlignment="Center"/>
                        <Label Content="Fifth" Grid.Column="3" HorizontalAlignment="Center"/>
                        <Label Content="Reg" Grid.Column="5" HorizontalAlignment="Center"/>
                        <Label Content="Half" Grid.Column="6" HorizontalAlignment="Center"/>
                        <Label Content="Fifth" Grid.Column="7" HorizontalAlignment="Center"/>
                        <Label Content="Reg" Grid.Column="9" HorizontalAlignment="Center"/>
                        <Label Content="Half" Grid.Column="10" HorizontalAlignment="Center"/>
                        <Label Content="Fifth" Grid.Column="11" HorizontalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Name="AccountingProf" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Label Content="Accounting (05%)" Grid.Column="1" />
                                    <TextBox Name="AccountingReg" Text="" Grid.Column="2" />
                                    <TextBox Name="AccountingHalf" Text="{Binding ElementName=AccountingReg,Path=Text,Converter={StaticResource HalfConverter}}" Grid.Column="3" />
                                    <TextBox Name="AccountingFifth" Text="{Binding ElementName=AccountingReg,Path=Text,Converter={StaticResource FifthConverter}}" Grid.Column="4" />
                                </Grid>


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Label Name="AnthropologyProf" Content="Anthropology (01%)" Grid.Column="1" />
                                    <TextBox Name="AnthropologyReg" Text="" Grid.Column="2" />
                                    <TextBox Name="AnthropologyHalf" Text="{Binding ElementName=AnthropologyReg,Path=Text,Converter={StaticResource HalfConverter}}" Grid.Column="3" />
                                    <TextBox Name="AnthropologyFifth" Text="{Binding ElementName=AnthropologyReg,Path=Text,Converter={StaticResource FifthConverter}}" Grid.Column="4" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Name="AppraiseProf" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Label Content="Appraise (05%)" Grid.Column="1" />
                                    <TextBox Name="AppraiseReg" Text="" Grid.Column="2" />
                                    <TextBox Name="AppraiseHalf" Text="{Binding ElementName=AppraiseReg,Path=Text,Converter={StaticResource HalfConverter}}" Grid.Column="3" />
                                    <TextBox Name="AppraiseFifth" Text="{Binding ElementName=AppraiseReg,Path=Text,Converter={StaticResource FifthConverter}}" Grid.Column="4" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Name="ArcheologyProf" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Label Content="Archeology (01%)" Grid.Column="1" />
                                    <TextBox Name="ArcheologyReg" Text="" Grid.Column="2" />
                                    <TextBox Name="ArcheologyHalf" Text="{Binding ElementName=ArcheologyReg,Path=Text,Converter={StaticResource HalfConverter}}" Grid.Column="3" />
                                    <TextBox Name="ArcheologyFifth" Text="{Binding ElementName=ArcheologyReg,Path=Text,Converter={StaticResource FifthConverter}}" Grid.Column="4" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Name="ArtProf" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBox Name="ArtCraft" Text="Art/Craft (05%)" Grid.Column="1" />
                                    <TextBox Name="ArtCraftReg" Text="" Grid.Column="2" />
                                    <TextBox Name="ArtCraftHalf" Text="{Binding ElementName=ArtCraftReg,Path=Text,Converter={StaticResource HalfConverter}}" Grid.Column="3" />
                                    <TextBox Name="ArtCraftFifth" Text="{Binding ElementName=ArtCraftReg,Path=Text,Converter={StaticResource FifthConverter}}" Grid.Column="4" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Name="CharmProf" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Label Content="Charm (15%)" Grid.Column="1" />
                                    <TextBox Name="CharmReg" Text="" Grid.Column="2" />
                                    <TextBox Name="CharmHalf" Text="{Binding ElementName=CharmReg,Path=Text,Converter={StaticResource HalfConverter}}" Grid.Column="3" />
                                    <TextBox Name="CharmFifth" Text="{Binding ElementName=CharmReg,Path=Text,Converter={StaticResource FifthConverter}}" Grid.Column="4" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Name="ClimbProf" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Label Content="Climb (20%)" Grid.Column="1" />
                                    <TextBox Name="ClimbReg" Text="" Grid.Column="2" />
                                    <TextBox Name="ClimbHalf" Text="{Binding ElementName=CharmReg,Path=Text,Converter={StaticResource HalfConverter}}" Grid.Column="3" />
                                    <TextBox Name="ClimbFifth" Text="{Binding ElementName=CharmReg,Path=Text,Converter={StaticResource FifthConverter}}" Grid.Column="4" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Content="Credit Rating (00%)" Grid.Column="1" />
                                    <TextBox Name="CreditReg" Text="" Grid.Column="2" />
                                    <TextBox Name="CreditHalf" Text="{Binding ElementName=CreditReg,Path=Text,Converter={StaticResource HalfConverter}}" Grid.Column="3" />
                                    <TextBox Name="CreditFifth" Text="{Binding ElementName=CreditReg,Path=Text,Converter={StaticResource FifthConverter}}" Grid.Column="4" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="3*"/>
